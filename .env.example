# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32
NODE_ENV=development

# API
PORT=4000
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_DOCS_ENABLED=true
RATE_LIMIT_MAX=300

# Versioned password peppers: JSON map of version to base64 key. Never delete a version still in use.
PASSWORD_PEPPERS='{"v1":""}'
PASSWORD_PEPPER_CURRENT=v1

# Optional social login: set both values to enable a provider
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web (server side only)
API_INTERNAL_URL=http://localhost:4000

# Docker production (docker/compose.yml)
PUBLIC_URL=https://localhost
SERVER_NAME=localhost
ACME_EMAIL=
POSTGRES_PASSWORD=
