    "@repo/validators": "workspace:*",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@elysiajs/eden": "1.4.9",
    "@repo/tsconfig": "workspace:*",
    "openapi-types": "12.1.3"
  }
}
