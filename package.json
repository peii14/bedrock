{
  "name": "web-dev-starter",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker/compose.dev.yml up -d --wait && bun --env-file=.env turbo dev",
    "build": "turbo build",
    "start": "bun --env-file=.env turbo start",
    "typecheck": "turbo typecheck",
    "test": "bun --env-file=.env turbo test",
    "check": "biome check . && bun scripts/check-file-length.ts",
    "fix": "biome check --write .",
    "db:generate": "bun --env-file=.env --filter @repo/db db:generate",
    "db:migrate": "bun --env-file=.env --filter @repo/db db:migrate",
    "db:seed": "bun --env-file=.env --filter @repo/api db:seed",
    "db:studio": "bun --env-file=.env --filter @repo/db db:studio",
    "secrets": "bun scripts/generate-secrets.ts",
    "prepare": "lefthook install || true",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "scan:secrets": "secretlint \"**/*\"",
    "scan:sast": "semgrep scan --config p/typescript --config p/nodejs --config p/owasp-top-ten --config .semgrep --error --metrics off",
    "scan:deps": "bun audit --audit-level=high",
    "scan": "bun run scan:secrets && bun run scan:deps"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "2.1.16",
    "secretlint": "13.0.6",
    "turbo": "2.11.6",
    "typescript": "7.0.2"
  }
}
